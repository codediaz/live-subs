# Set this key before starting the worker.
GEMINI_API_KEY=

# Shared
REDIS_URL=redis://redis:6379/0
SESSIONS_FILE=sessions.yaml
LOG_LEVEL=INFO

# Worker
TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
TRANSCRIBE_VOCABULARY=Nerdearla,Konex,Kubernetes,Gemini,open source
TRANSLATE_MODEL=gemini-3.5-flash-lite
TRANSLATE_THINKING_LEVEL=MINIMAL
TRANSLATE_TIMEOUT_S=10
TRANSLATION_CONTEXT_SEGMENTS=3
TRANSLATION_QUEUE_MAX=10
AUDIO_CHUNK_MS=100
AUDIO_QUEUE_MAX_CHUNKS=50
VOICE_RMS_THRESHOLD=500
AUDIO_CLOCK_WINDOW_S=120
SOURCE_END_GRACE_MS=3000
STATUS_INTERVAL_S=2
STATUS_TTL_S=15
VAD_END_SENSITIVITY=HIGH
VAD_SILENCE_MS=300
MAX_SEGMENT_MS=8000
WORKER_SESSIONS=

# Gateway
GATEWAY_PORT=8000
WS_PING_S=20
WS_CLIENT_QUEUE_MAX=100
RECENT_FINALS_N=5

# P1 settings; unused in P0.
# HISTORY_MAX_EVENTS=5000
# HISTORY_TTL_S=86400
